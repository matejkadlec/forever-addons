# /etc/forever-market-feed/feed.env (0600, never in git). Values are entered by the owner.
DATABASE_URL=postgresql://feed:CHANGE_ME@db:5432/feed
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# bearer token of the read API, the PC puts the same into its .env.market-feed (openssl rand -hex 32)
FEED_API_TOKEN=
FEED_REGION=eu
FEED_RULESET=1
FEED_HOUSE=110
FEED_FACTION=Alliance
FEED_BUCKET=CAMWOW EU4 Realm 2 PvP-Alliance
FEED_RECORD_HOURS=4
FEED_INTERVAL=1800
FEED_KEEP_DAYS=90
