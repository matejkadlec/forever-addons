# Installed for the fmf-deploy account by deploy/provision-server.sh; enabled by hand once the first run of its
# service has passed (README.md, section Server).
[Unit]
Description=ForeverMarket feed: monthly restore rehearsal

[Timer]
OnCalendar=*-*-03 05:10:00 Europe/Prague
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
