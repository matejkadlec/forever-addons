# Installed for the fmf-deploy account by deploy/provision-server.sh.
[Unit]
Description=ForeverMarket feed: restore rehearsal
Documentation=https://github.com/matejkadlec/forever-addons/blob/master/services/forever-market-feed/README.md
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/forever-market-feed-backup rehearse
# Must never compete with the sites for CPU or disk.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
