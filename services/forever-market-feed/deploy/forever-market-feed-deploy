#!/usr/bin/env bash
# Deploys one commit of the ForeverMarket feed server on the production host.
#
# Installed root-owned as /usr/local/libexec/forever-market-feed-deploy by deploy/provision-server.sh and run by
# the unprivileged `fmf-deploy` account with its own rootless Docker daemon. README.md (section Server) describes
# the whole arrangement.
#
# It is the forced command of the GitHub Actions SSH key, which can therefore only ask for:
#
#   deploy <40-hex commit>    build and start that commit; it must be on master
#   status                    print the deployed commit, the containers, the monitor and backup evidence
#
# An administrator can run more on the host, and may name another branch:
#
#   sudo -u fmf-deploy /usr/local/libexec/forever-market-feed-deploy <operation>
#
#   init <commit> [<branch>]      first deployment only: create the PostgreSQL volume, the read-only role and
#                                 the tables; the collector and the API stay stopped
#   deploy <commit> [<branch>]    deploy, or roll back to, anything pushed
#   status
#   monitor                       the check the monitor timer runs; records its outcome
#   logs <service> [<lines>]      the last log lines of db, collector, api or cloudflared
#
# Only services/forever-market-feed of the commit is used. The source always comes from the public repository
# over HTTPS, never from the SSH client. A release that does not become healthy is replaced by the previous one.
set -euo pipefail
umask 077
export PATH=/usr/local/bin:/usr/bin:/bin
export LC_ALL=C

readonly ACCOUNT=fmf-deploy
readonly REPOSITORY=https://github.com/matejkadlec/forever-addons.git
readonly DEFAULT_BRANCH=master
readonly SERVICE_PATH=services/forever-market-feed
readonly ROOT=/srv/forever-market-feed
readonly CONFIG=/etc/forever-market-feed
readonly PROJECT=forever-market-feed
readonly COMPOSE_FILE=compose.yml
readonly IMAGE=forever-market-feed
readonly DB_CONTAINER=forever-market-feed-db
readonly API_CONTAINER=forever-market-feed-api
# What a commit must change (inside SERVICE_PATH) for the running containers to differ.
readonly DEPLOYED_PATHS=(Dockerfile .dockerignore requirements.lock feed.py server.py "$COMPOSE_FILE")
# Generated by provisioning (the first two) or written by the owner (the other two).
readonly PRIVATE_FILES=(postgres.env api-database.env collector.env api.env)
readonly PRE_DEPLOY_DUMPS_KEPT=3

log() { printf '[deploy] %s\n' "$*"; }
die() {
  printf '[deploy] error: %s\n' "$*" >&2
  exit 1
}

[[ "$(id -un)" == "$ACCOUNT" ]] || die "must run as $ACCOUNT"

#------------------------------------------------------------------------------
# Request: from the SSH client (strict) or from an administrator's arguments
#------------------------------------------------------------------------------

operation=""
commit=""
branch="$DEFAULT_BRANCH"
automated=false
log_service=""
log_lines=200

require_commit_and_branch() {
  (($# == 1 || $# == 2)) || die "usage: $operation <40-hex commit> [<branch>]"
  commit="$1"
  branch="${2:-$DEFAULT_BRANCH}"
  [[ "$commit" =~ ^[0-9a-f]{40}$ ]] || die "the commit must be a full lowercase SHA-1"
  [[ "$branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ && "$branch" != *..* ]] || die "invalid branch name"
}

if (($# == 0)); then
  automated=true
  request="${SSH_ORIGINAL_COMMAND:-}"
  if [[ "$request" == "status" ]]; then
    operation=status
  elif [[ "$request" =~ ^deploy\ ([0-9a-f]{40})$ ]]; then
    operation=deploy
    commit="${BASH_REMATCH[1]}"
  else
    die "expected 'deploy <40-hex commit>' or 'status'"
  fi
else
  operation="$1"
  shift
  case "$operation" in
    status | monitor)
      (($# == 0)) || die "usage: $operation"
      ;;
    init | deploy)
      require_commit_and_branch "$@"
      ;;
    logs)
      (($# == 1 || $# == 2)) || die "usage: logs db|collector|api|cloudflared [<lines>]"
      log_service="$1"
      log_lines="${2:-200}"
      [[ "$log_service" =~ ^(db|collector|api|cloudflared)$ ]] || die "unknown service"
      [[ "$log_lines" =~ ^[1-9][0-9]{0,4}$ ]] || die "invalid number of lines"
      ;;
    *)
      die "unknown operation"
      ;;
  esac
fi

#------------------------------------------------------------------------------
# Environment: the account's rootless Docker daemon, git without user settings
#------------------------------------------------------------------------------

export HOME="/home/$ACCOUNT"
XDG_RUNTIME_DIR="/run/user/$(id -u)"
export XDG_RUNTIME_DIR
export DOCKER_HOST="unix://$XDG_RUNTIME_DIR/docker.sock"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_TERMINAL_PROMPT=0
cd "$ROOT"

readonly GIT_DIR_PATH="$ROOT/repository"
readonly RELEASES="$ROOT/releases"
readonly STATE="$ROOT/state"
readonly PRE_DEPLOY_DUMPS="$ROOT/backups/pre-deploy"
# The commit whose image and Compose file are running.
readonly CURRENT_FILE="$STATE/current-release"
readonly PREVIOUS_FILE="$STATE/previous-release"
# The newest commit the running release is known to serve. It is ahead of current-release after a commit that
# changed none of DEPLOYED_PATHS.
readonly DEPLOYED_FILE="$STATE/deployed-commit"
readonly INPUTS_FILE="$STATE/current-inputs"
# Written by `init`. Without it a deploy refuses, so a missing or replaced volume can never be answered by
# starting on an empty database.
readonly INITIALIZED_FILE="$STATE/database-initialized"
readonly MONITOR_FILE="$STATE/monitor"

read_release() {
  local value=""
  [[ -f "$1" ]] && value="$(<"$1")"
  [[ "$value" =~ ^[0-9a-f]{40}$ ]] && printf '%s' "$value"
  return 0
}

write_state() {
  printf '%s\n' "$2" >"$1.new"
  mv -- "$1.new" "$1"
}

tunnel_enabled() { [[ -s "$CONFIG/cloudflared-token" ]]; }

# compose <release> <arguments...>: Docker Compose on that release's file. The two variables the file reads are
# set here and nowhere else; the tunnel connector is part of the stack only once the owner has stored its token.
compose() {
  local release="$1"
  shift
  local profile=()
  tunnel_enabled && profile=(--profile tunnel)
  RELEASE="$release" FMF_CONFIG_DIRECTORY="$CONFIG" docker compose \
    --project-name "$PROJECT" \
    --project-directory "$RELEASES/$release" \
    --file "$RELEASES/$release/$COMPOSE_FILE" \
    "${profile[@]}" "$@"
}

container_running() {
  [[ "$(docker inspect --format '{{.State.Running}}' "$1" 2>/dev/null)" == "true" ]]
}

# A fixed container name alone could belong to anything; require this project's own Compose labels.
require_project_container() {
  local name="$1" service="$2" labels
  labels="$(docker inspect --format \
    '{{index .Config.Labels "com.docker.compose.project"}}/{{index .Config.Labels "com.docker.compose.service"}}' \
    "$name" 2>/dev/null)" || die "there is no container $name"
  [[ "$labels" == "$PROJECT/$service" ]] || die "$name is not the $service service of $PROJECT"
}

# db_query <sql>: one unaligned value, as the database owner over the container's local socket.
db_query() {
  docker exec --user postgres "$DB_CONTAINER" sh -ceu \
    'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --no-psqlrc --set ON_ERROR_STOP=1 --tuples-only --no-align --command "$1"' \
    -- "$1"
}

# db_script: SQL from stdin, as the database owner.
db_script() {
  docker exec --interactive --user postgres "$DB_CONTAINER" sh -ceu \
    'exec psql --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --no-psqlrc --set ON_ERROR_STOP=1 --quiet'
}

# api_probe: what the API answers inside its own container, as "<healthz code> <healthz error or -> <snapshot
# age in seconds or -1> <code of /v1/status without a token>". Nothing here needs or prints a secret.
api_probe() {
  docker exec "$API_CONTAINER" python -c '
import json, urllib.error, urllib.request
def get(path):
    try:
        with urllib.request.urlopen("http://127.0.0.1:8080" + path, timeout=10) as answer:
            return answer.status, answer.read()
    except urllib.error.HTTPError as err:
        return err.code, err.read()
code, body = get("/healthz")
health = json.loads(body or b"{}")
age = health.get("age")
print(code, health.get("error") or "-", -1 if age is None else int(age), get("/v1/status")[0])
'
}

#------------------------------------------------------------------------------
# logs: no lock, nothing changes
#------------------------------------------------------------------------------

if [[ "$operation" == "logs" ]]; then
  # Every container has a fixed name: forever-market-feed-<service>.
  exec docker logs --timestamps --tail "$log_lines" "$PROJECT-$log_service"
fi

# One lock for deployments, backups and the monitor. A deployment waits for a backup (about a minute) instead of
# failing; the monitor skips a check rather than delay a deployment.
exec 9>"$STATE/operation.lock"
if [[ "$operation" == "monitor" ]]; then
  if ! flock --nonblock 9; then
    log "a deployment or backup is running; check skipped"
    exit 0
  fi
else
  flock --wait 900 9 || die "another deployment or backup is still running"
fi
current="$(read_release "$CURRENT_FILE")"
deployed="$(read_release "$DEPLOYED_FILE")"
[[ -n "$deployed" ]] || deployed="$current"

#------------------------------------------------------------------------------
# status
#------------------------------------------------------------------------------

print_evidence() {
  if [[ -f "$2" ]]; then
    printf '%s: %s\n' "$1" "$(tr '\n' ' ' <"$2")"
  else
    printf '%s: none recorded\n' "$1"
  fi
}

if [[ "$operation" == "status" ]]; then
  [[ -n "$current" ]] || die "nothing is deployed yet"
  log "deployed commit: $deployed"
  [[ "$deployed" == "$current" ]] || log "running release: $current (nothing deployed has changed since)"
  compose "$current" ps --all --format '{{.Service}}: {{.State}} {{.Health}}'
  print_evidence monitor "$MONITOR_FILE"
  print_evidence last-backup "$STATE/backups/last-backup"
  [[ ! -f "$STATE/backups/last-backup-failure" ]] || print_evidence last-backup-failure "$STATE/backups/last-backup-failure"
  print_evidence last-check "$STATE/backups/last-check"
  print_evidence last-rehearsal "$STATE/backups/last-rehearsal"
  exit 0
fi

#------------------------------------------------------------------------------
# monitor: the containers, and the API's own view of the newest snapshot
# (/healthz answers 503 when none arrived for 3 hours). The outcome replaces the
# previous one, so an old success never vouches for a broken stack.
#------------------------------------------------------------------------------

if [[ "$operation" == "monitor" ]]; then
  problems=()
  if [[ -z "$current" ]]; then
    problems+=("nothing is deployed")
  else
    states="$(compose "$current" ps --all --format '{{.Service}}={{.State}}/{{.Health}}' 2>/dev/null)" ||
      problems+=("docker compose ps failed")
    expected=(db=running/healthy api=running/healthy collector=running/)
    tunnel_enabled && expected+=(cloudflared=running/healthy)
    for state in "${expected[@]}"; do
      grep -Fqx "$state" <<<"$states" ||
        problems+=("${state%%=*} is $(sed -n "s/^${state%%=*}=//p" <<<"$states" | head -n 1)")
    done
    code="" error="" age="" status_code=""
    probe="$(api_probe 2>/dev/null)" || probe=""
    read -r code error age status_code <<<"$probe" || true
    if [[ "$code" == "503" && "$error" == "-" ]]; then
      if [[ "$age" == "-1" ]]; then
        problems+=("no snapshot yet")
      else
        problems+=("newest snapshot is $((age / 3600)) hours old")
      fi
    elif [[ "$code" != "200" ]]; then
      problems+=("healthz answered '${code:-nothing}' (${error:--})")
    fi
    [[ -z "$status_code" || "$status_code" == "401" ]] || problems+=("/v1/status without a token answered $status_code")
  fi
  {
    if ((${#problems[@]} == 0)); then
      printf 'result=ok\n'
    else
      printf 'result=failed\n'
    fi
    printf 'at=%s\nepoch=%s\n' "$(date --utc +%Y-%m-%dT%H:%M:%SZ)" "$(date +%s)"
    if ((${#problems[@]} == 0)); then
      printf 'snapshot_age_minutes=%s\n' "$((${age:-0} / 60))"
    else
      printf 'problems=%s\n' "$(printf '%s; ' "${problems[@]}")"
    fi
  } >"$MONITOR_FILE.new"
  mv -- "$MONITOR_FILE.new" "$MONITOR_FILE"
  if ((${#problems[@]} > 0)); then
    die "$(printf '%s; ' "${problems[@]}")"
  fi
  log "healthy, newest snapshot $((${age:-0} / 60)) minutes old"
  exit 0
fi

#------------------------------------------------------------------------------
# init and deploy: the private files, then fetch the branch, check the commit,
# unpack the service folder of it
#------------------------------------------------------------------------------

for private_file in "${PRIVATE_FILES[@]}"; do
  [[ -f "$CONFIG/$private_file" && ! -L "$CONFIG/$private_file" ]] ||
    die "$CONFIG/$private_file is missing (README.md, section Server)"
  [[ "$(stat -c '%a' "$CONFIG/$private_file")" == "600" ]] || die "$CONFIG/$private_file must have mode 0600"
done
# Checked without reading the values into this script or printing them.
if ! grep -Eq '^BLIZZARD_CLIENT_ID=.+' "$CONFIG/collector.env" ||
  ! grep -Eq '^BLIZZARD_CLIENT_SECRET=.+' "$CONFIG/collector.env"; then
  die "$CONFIG/collector.env needs BLIZZARD_CLIENT_ID and BLIZZARD_CLIENT_SECRET"
fi
grep -Eq '^FEED_API_TOKEN=.{24,}$' "$CONFIG/api.env" || die "$CONFIG/api.env needs FEED_API_TOKEN (24 characters or more)"

[[ -d "$GIT_DIR_PATH/objects" ]] || git init --quiet --bare "$GIT_DIR_PATH"
git_repository() { git --git-dir "$GIT_DIR_PATH" "$@"; }

log "fetching $branch"
git_repository fetch --quiet --no-tags --force "$REPOSITORY" "refs/heads/$branch:refs/deploy/branch"
git_repository cat-file -e "$commit^{commit}" 2>/dev/null || die "commit $commit is not on $branch"
git_repository merge-base --is-ancestor "$commit" refs/deploy/branch || die "commit $commit is not on $branch"

# Two pushes in quick succession can arrive out of order; automation never goes back in history.
if $automated && [[ -n "$deployed" && "$commit" != "$deployed" ]] &&
  git_repository merge-base --is-ancestor "$commit" "$deployed" 2>/dev/null; then
  log "a newer commit ($deployed) is already deployed; nothing to do"
  exit 0
fi

inputs_of() {
  local path
  for path in "${DEPLOYED_PATHS[@]}"; do
    git_repository rev-parse --verify --quiet "$1:$SERVICE_PATH/$path" || die "commit $1 has no $SERVICE_PATH/$path"
  done | sha256sum | cut -d ' ' -f 1
}
inputs="$(inputs_of "$commit")"

stack_healthy() {
  local states
  states="$(compose "$1" ps --format '{{.Service}}={{.State}}/{{.Health}}' 2>/dev/null)" || return 1
  grep -Fqx 'db=running/healthy' <<<"$states" &&
    grep -Fqx 'api=running/healthy' <<<"$states" &&
    grep -Fqx 'collector=running/' <<<"$states" || return 1
  ! tunnel_enabled || grep -Fqx 'cloudflared=running/healthy' <<<"$states"
}

# A commit that changed nothing the containers are built from (documentation, the Windows task, the deploy
# scripts, which provisioning installs) is served by the running release already.
if $automated && [[ "$operation" == "deploy" && -n "$current" && -f "$INPUTS_FILE" &&
  "$(<"$INPUTS_FILE")" == "$inputs" ]] && stack_healthy "$current"; then
  write_state "$DEPLOYED_FILE" "$commit"
  log "commit $commit changes nothing that is deployed; release $current keeps running"
  exit 0
fi

incoming=""
cleanup() { [[ -z "$incoming" ]] || rm -rf -- "$incoming"; }
trap cleanup EXIT

if [[ ! -d "$RELEASES/$commit" ]]; then
  # The private (0700) directory protects the release on the host; the files inside keep the usual 0644/0755
  # modes, because the image build copies the modes and the containers run unprivileged.
  incoming="$(mktemp -d "$RELEASES/.incoming.XXXXXXXX")"
  git_repository -c tar.umask=0022 archive --format=tar "$commit:$SERVICE_PATH" |
    tar -x -C "$incoming" --no-same-owner --preserve-permissions
  [[ -f "$incoming/$COMPOSE_FILE" && -f "$incoming/Dockerfile" && -f "$incoming/deploy/readonly-role.sql" ]] ||
    die "the commit has no $SERVICE_PATH/$COMPOSE_FILE, Dockerfile or deploy/readonly-role.sql"
  mv -- "$incoming" "$RELEASES/$commit"
  incoming=""
fi

#------------------------------------------------------------------------------
# The PostgreSQL volume. Its name is written in the Compose file and nowhere
# else; Compose's own resolved configuration is where it is read from. That
# output also carries the private environment files, so it only ever goes
# through the filter below, never to the terminal.
#------------------------------------------------------------------------------

volume_name="$(
  compose "$commit" config --format json |
    python3 -c 'import json, sys; print(json.load(sys.stdin)["volumes"]["postgres_data"]["name"])'
)"
[[ "$volume_name" =~ ^[a-z0-9][a-z0-9_.-]+$ ]] || die "cannot read the PostgreSQL volume name from $COMPOSE_FILE"
volume_exists() { docker volume inspect "$volume_name" >/dev/null 2>&1; }

#------------------------------------------------------------------------------
# init: an empty volume, the read-only role with its generated password, the tables
#------------------------------------------------------------------------------

set_api_password() {
  local password
  password="$(sed -n 's/^PGPASSWORD=//p' "$CONFIG/api-database.env" | head -n 1)"
  [[ "$password" =~ ^[0-9a-f]{64}$ ]] || die "$CONFIG/api-database.env holds no generated password"
  # Through stdin, never an argument; a failing statement must not be written into the server log either.
  printf "SET log_min_error_statement TO panic;\nALTER ROLE feed_api PASSWORD '%s';\n" "$password" | db_script >/dev/null
}

if [[ "$operation" == "init" ]]; then
  [[ -z "$current" && ! -e "$INITIALIZED_FILE" ]] ||
    die "this host has been initialized already; init is for the first deployment only"
  ! volume_exists || die "the volume $volume_name exists already; refusing to initialize over it"

  log "building $commit"
  compose "$commit" build

  log "creating the PostgreSQL volume $volume_name"
  docker volume create "$volume_name" >/dev/null
  log "starting PostgreSQL"
  compose "$commit" up --detach --wait --wait-timeout 180 db
  require_project_container "$DB_CONTAINER" db
  [[ "$(db_query "SELECT to_regclass('public.feed_state') IS NULL AND NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'feed_api')")" == "t" ]] ||
    die "the new database is not empty"

  log "creating the read-only role feed_api"
  db_script <"$RELEASES/$commit/deploy/readonly-role.sql" >/dev/null
  set_api_password

  log "creating the tables"
  compose "$commit" run --rm --no-deps collector migrate
  [[ "$(db_query "SELECT has_table_privilege('feed_api', 'public.feed_state', 'SELECT') AND has_table_privilege('feed_api', 'public.feed_snapshot', 'SELECT')")" == "t" ]] ||
    die "feed_api cannot read the tables"

  write_state "$INITIALIZED_FILE" "$(date --utc +%Y-%m-%dT%H:%M:%SZ) $volume_name"
  log "initialized; PostgreSQL is running, the collector and the API are not"
  log "next: deploy $commit${branch:+ $branch}"
  exit 0
fi

#------------------------------------------------------------------------------
# deploy: refuse an uninitialized or missing database before touching anything
#------------------------------------------------------------------------------

[[ -e "$INITIALIZED_FILE" ]] ||
  die "this host has not been initialized; an administrator must run: init <commit>"
volume_exists ||
  die "the PostgreSQL volume $volume_name is missing; refusing to start on an empty database"

log "building $commit"
compose "$commit" build

pre_deploy_dump=""
dump_database() {
  local target
  install -d -m 0700 "$PRE_DEPLOY_DUMPS"
  target="$PRE_DEPLOY_DUMPS/$(date --utc +%Y%m%dT%H%M%SZ)-before-${commit:0:12}.dump"
  docker exec --user postgres "$DB_CONTAINER" sh -ceu \
    'exec pg_dump --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --format=custom --no-password' \
    >"$target.partial"
  docker exec --interactive --user postgres "$DB_CONTAINER" pg_restore --list <"$target.partial" >/dev/null
  mv -- "$target.partial" "$target"
  pre_deploy_dump="$target"
  log "pre-deployment dump: $target ($(stat -c '%s' "$target") bytes)"
}

# Before anything is replaced when PostgreSQL is up, which is the normal case.
if container_running "$DB_CONTAINER"; then
  require_project_container "$DB_CONTAINER" db
  dump_database
fi
log "starting PostgreSQL"
compose "$commit" up --detach --wait --wait-timeout 180 db
[[ "$(db_query "SELECT to_regclass('public.feed_state') IS NOT NULL")" == "t" ]] ||
  die "the database in $volume_name has no tables although this host was initialized; refusing to continue"
[[ -n "$pre_deploy_dump" ]] || dump_database

#------------------------------------------------------------------------------
# deploy: start the release, keep the previous one when the new one is not healthy
#------------------------------------------------------------------------------

# What the container health checks cannot see: the API reaches the database as feed_api (/healthz carries no
# error; 503 only means no fresh snapshot yet) and refuses a request without the token.
verify() {
  local probe code error age status_code
  probe="$(api_probe)" || return 1
  read -r code error age status_code <<<"$probe" || return 1
  [[ "$error" == "-" && ("$code" == "200" || "$code" == "503") && "$status_code" == "401" ]] && return 0
  log "the API answered /healthz $code (${error}), /v1/status without a token $status_code"
  return 1
}

start() { compose "$1" up --detach --wait --wait-timeout 180 --remove-orphans && verify; }

log "starting $commit"
if ! start "$commit"; then
  log "the new release did not become healthy; its last log lines:"
  compose "$commit" ps --all --format '{{.Service}}: {{.State}} {{.Health}}' >&2 || true
  compose "$commit" logs --no-color --tail 40 collector api >&2 || true
  if [[ -n "$current" && "$current" != "$commit" && -d "$RELEASES/$current" ]]; then
    log "restoring $current"
    start "$current" || die "the previous release could not be restored"
    rm -rf -- "${RELEASES:?}/$commit"
    docker image rm "$IMAGE:$commit" >/dev/null 2>&1 || true
    die "deployment failed; $current is running again (database state before it: $pre_deploy_dump)"
  fi
  die "deployment failed"
fi

if [[ "$commit" != "$current" ]]; then
  [[ -z "$current" ]] || write_state "$PREVIOUS_FILE" "$current"
  write_state "$CURRENT_FILE" "$commit"
fi
write_state "$DEPLOYED_FILE" "$commit"
write_state "$INPUTS_FILE" "$inputs"
previous="$(read_release "$PREVIOUS_FILE")"

#------------------------------------------------------------------------------
# deploy: keep only the running release and the one before it
#------------------------------------------------------------------------------

for directory in "$RELEASES"/*/; do
  name="$(basename "$directory")"
  [[ "$name" =~ ^[0-9a-f]{40}$ ]] || continue
  [[ "$name" == "$commit" || "$name" == "$previous" ]] || rm -rf -- "$directory"
done
while read -r tag; do
  [[ "$tag" =~ ^[0-9a-f]{40}$ ]] || continue
  [[ "$tag" == "$commit" || "$tag" == "$previous" ]] || docker image rm "$IMAGE:$tag" >/dev/null 2>&1 || true
done < <(docker image ls --format '{{.Tag}}' "$IMAGE")
docker image prune --force >/dev/null 2>&1 || true
docker builder prune --force --filter until=168h >/dev/null 2>&1 || true
mapfile -t dumps < <(find "$PRE_DEPLOY_DUMPS" -maxdepth 1 -type f -name '*.dump' | sort --reverse)
for dump in "${dumps[@]:$PRE_DEPLOY_DUMPS_KEPT}"; do
  rm -f -- "$dump"
done
find "$PRE_DEPLOY_DUMPS" -maxdepth 1 -type f -name '*.partial' -delete

log "deployed $commit"
compose "$commit" ps --all --format '{{.Service}}: {{.State}} {{.Health}}'
