# Names only. The real file is /etc/forever-market-feed/backup.env on the server (owner fmf-deploy, mode 0600)
# and never enters Git, GitHub, logs or a chat. README.md (section Server) has the no-echo command that writes it.
#
# One line per name, NAME=value, no quotes and no spaces around the equals sign.
#
# A bucket (or a prefix in one) used by the ForeverMarket feed alone, on FORPSI Object Storage, with an access
# key that can reach nothing else.
RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/forever-market-feed
AWS_ACCESS_KEY_ID=<access key of the dedicated credential>
AWS_SECRET_ACCESS_KEY=<its secret key>
AWS_DEFAULT_REGION=<region the endpoint expects>
