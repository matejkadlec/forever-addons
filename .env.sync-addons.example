# Copy this file to .env.sync-addons and set it to be the absolute path to your WoW: Forever AddOns folder
# Example (WSL): SYNC_ADDONS_DEST_DIR="/mnt/c/Program Files (x86)/World of Warcraft/_forever_/Interface/AddOns"
SYNC_ADDONS_DEST_DIR=""
SYNC_ADDONS_AUTO_INSTALL_RSYNC="0"

# Optional overrides
# SYNC_ADDONS_SOURCE_DIR replaces both addons/ and backports/ as the source
# SYNC_ADDONS_SOURCE_DIR="/absolute/path/to/your/addons"
# SYNC_ADDONS_RSYNC_BIN="/usr/bin/rsync"
